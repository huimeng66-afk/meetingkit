{
  "name": "MeetingKit · 会议",
  "short_name": "MeetingKit",
  "description": "MeetingKit 网页测试版：仅用于验证会议界面与交互，不含音视频。",
  "lang": "zh-CN",
  "dir": "ltr",
  "id": "./",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "fullscreen"],
  "orientation": "portrait",
  "background_color": "#07080A",
  "theme_color": "#0B0C0F",
  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    }
  ]
}
